# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# Backend API URL (Phase 2)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# MCP Server URL
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:3001

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
